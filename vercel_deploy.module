<?php

/**
 * @file
 * Contains vercel_deploy.module hooks.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\vercel_deploy\Hook\VercelDeployHooks;

/**
 * Implements hook_toolbar().
 */
#[LegacyHook]
function vercel_deploy_toolbar() {
  return \Drupal::service(VercelDeployHooks::class)->toolbar();
}

/**
 * Implements hook_help().
 */
#[LegacyHook]
function vercel_deploy_help(string $route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(VercelDeployHooks::class)->help($route_name, $route_match);
}
